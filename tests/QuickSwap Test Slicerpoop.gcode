; change_filament_gcode = {if toolchange_count > 1}\nSET_VELOCITY_LIMIT ACCEL=[travel_acceleration]\n{if !purge_in_prime_tower || wipe_tower_type != \"type2\" || print_sequence == \"by object\"}\nT[next_extruder]\n_GOTO_TRASH\n{if flush_length > 0}\nSET_FAN_SPEED FAN=fanM106 SPEED=0\n_DISABLE_SENSOR\n; FLUSH_START\n{if flush_length_1 == 0}\nG1 E2 F{min(old_filament_e_feedrate, new_filament_e_feedrate) / 2}\nG1 E{flush_length + old_retract_length_toolchange - 2} F{min(old_filament_e_feedrate, new_filament_e_feedrate)}\nSET_FAN_SPEED FAN=fanM106 SPEED=1\nG4 P4000\nM400\nG1 E-1 F{new_filament_e_feedrate / 2}\n_SBROS_TRASH\nSET_FAN_SPEED FAN=fanM106 SPEED=0\n{else}\nG1 E2 F{min(old_filament_e_feedrate, new_filament_e_feedrate) / 2}\nG1 E{flush_length_1 + old_retract_length_toolchange - 2} F{min(old_filament_e_feedrate, new_filament_e_feedrate)}\nSET_FAN_SPEED FAN=fanM106 SPEED=1\nG4 P4000\nM400\nG1 E-1 F{new_filament_e_feedrate / 2}\n_SBROS_TRASH\nSET_FAN_SPEED FAN=fanM106 SPEED=0\n{if flush_length_2 > 0}\n_GOTO_TRASH\nG1 E2 F{new_filament_e_feedrate / 2}\nG1 E{flush_length_2 - 1} F{new_filament_e_feedrate}\nSET_FAN_SPEED FAN=fanM106 SPEED=1\nG4 P4000\nM400\nG1 E-1 F{new_filament_e_feedrate / 2}\n_SBROS_TRASH\nSET_FAN_SPEED FAN=fanM106 SPEED=0\n{endif}\n{if flush_length_3 > 0}\n_GOTO_TRASH\nG1 E2 F{new_filament_e_feedrate / 2}\nG1 E{flush_length_3 - 1} F{new_filament_e_feedrate}\nSET_FAN_SPEED FAN=fanM106 SPEED=1\nG4 P4000\nM400\nG1 E-1 F{new_filament_e_feedrate / 2}\n_SBROS_TRASH\nSET_FAN_SPEED FAN=fanM106 SPEED=0\n{endif}\n{if flush_length_4 > 0}\n_GOTO_TRASH\nG1 E2 F{new_filament_e_feedrate / 2}\nG1 E{flush_length_4 - 1} F{new_filament_e_feedrate}\nSET_FAN_SPEED FAN=fanM106 SPEED=1\nG4 P4000\nM400\nG1 E-1 F{new_filament_e_feedrate / 2}\n_SBROS_TRASH\nSET_FAN_SPEED FAN=fanM106 SPEED=0\n{endif}\n{endif}\n{if 1 - new_retract_length_toolchange < -2}\nG1 E-2 F{new_filament_e_feedrate / 2}\nG1 E{1 - new_retract_length_toolchange + 2} F{new_filament_e_feedrate}\n{endif}\n{if 1 - new_retract_length_toolchange >= -2 and 1 - new_retract_length_toolchange < 0}\nG1 E{1 - new_retract_length_toolchange} F{new_filament_e_feedrate / 2}\n{endif}\n{if 1 - new_retract_length_toolchange > 0 and 1 - new_retract_length_toolchange <= 2}\nG1 E{1 - new_retract_length_toolchange} F{new_filament_e_feedrate / 2}\n{endif}\n{if 1 - new_retract_length_toolchange > 2}\nG1 E2 F{new_filament_e_feedrate / 2}\nG1 E{1 - new_retract_length_toolchange - 2} F{new_filament_e_feedrate}\n{endif}\n; FLUSH_END\n_ENABLE_SENSOR\n{else}\nSET_FAN_SPEED FAN=fanM106 SPEED=1\nG4 P4000\nM400\n_SBROS_TRASH\n{endif}\n{if layer_num < close_fan_the_first_x_layers[next_extruder]}\nSET_FAN_SPEED FAN=fanM106 SPEED=0\n{elsif layer_num >= full_fan_speed_layer[next_extruder] - 1}\nSET_FAN_SPEED FAN=fanM106 SPEED={ fan_min_speed[next_extruder] / 100}\n{else}\nSET_FAN_SPEED FAN=fanM106 SPEED={ fan_min_speed[next_extruder] * (layer_num - close_fan_the_first_x_layers[next_extruder] + 1) / (full_fan_speed_layer[next_extruder] - close_fan_the_first_x_layers[next_extruder]) / 100}\n{endif}\nG1 X{((x_after_toolchange + 22) % 264) - 22} Y{242 - ((242 - y_after_toolchange) % 264)} F18000\nG1 Z{z_after_toolchange}\n{else}\nT[next_extruder]\n{endif}\n{if layer_num == 0}\nSET_VELOCITY_LIMIT ACCEL=[initial_layer_acceleration]\n{else}\nSET_VELOCITY_LIMIT ACCEL=[default_acceleration]\n{endif}\n{else}\nT[next_extruder]\n{endif}
